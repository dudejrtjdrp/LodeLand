    "balance-gate": "node scripts/balance-sim/run.mjs --gate --rounds=100"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.10"
  }
}
