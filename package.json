{
  "name": "lodeland",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=lodeland --branch=main --commit-dirty=true",
    "smoke:dist": "node scripts/deploy-smoke.mjs",
