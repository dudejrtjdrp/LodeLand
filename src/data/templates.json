        "hitbox": { "width": 56, "height": 86, "offsetX": 36, "offsetY": 57 },
        "stats": {
          "hp": 100,
          "speed": 150,
          "critChance": 0.05,
          "critDamageMultiplier": 1.5
        },
        "spriteType": "aseprite",
        "spritesheets": {
          "idle": {
            "filePath": "player/character_idle.png",
            "textureKey": "player-idle-sheet",
            "frameWidth": 128,
            "frameHeight": 128,
            "frameStart": 0,
            "frameCount": 6,
            "frameRate": 8,
            "repeat": -1
          }
        }
      }
    },
    "separate": {
      "description": "애니메이션별 별도 파일",
      "example": {
        "displaySize": { "width": 200, "height": 200 },
        "hitbox": { "width": 56, "height": 86, "offsetX": 36, "offsetY": 57 },
        "stats": {
          "hp": 100,
          "speed": 150,
          "critChance": 0.05,
          "critDamageMultiplier": 1.5
        },
        "spriteType": "separate",
        "spritesheets": {
          "idle": {
            "filePath": "player/character_idle.png",
            "textureKey": "player-idle-sheet",
            "frameWidth": 128,
            "frameHeight": 128,
            "frameStart": 0,
            "frameCount": 6,
            "frameRate": 8,
            "repeat": -1
          },
          "hurt": {
            "filePath": "player/character_hurt.png",
            "textureKey": "player-hurt-sheet",
            "frameWidth": 128,
            "frameHeight": 128,
            "frameStart": 0,
            "frameCount": 3,
            "frameRate": 10,
            "repeat": 0
          },
          "death": {
            "filePath": "player/character_death.png",
            "textureKey": "player-death-sheet",
            "frameWidth": 128,
            "frameHeight": 128,
            "frameStart": 0,
            "frameCount": 8,
            "frameRate": 10,
            "repeat": 0
          }
        }
      }
    }
  }
}
